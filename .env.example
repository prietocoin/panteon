# Token opcional para subir el rate limit de GitHub en Atlas.
GITHUB_TOKEN=

# URL del servicio TTS que verá el contenedor panteon.
PANTEON_TTS_URL=http://localhost:8000

# Crea un caso demo al arrancar si el workspace está vacío.
# En Docker se desactiva por defecto.
PANTEON_SEED=true

# Notificaciones de casos nuevos
PANTEON_NOTIFY_WEBHOOK=
PANTEON_TELEGRAM_TOKEN=
PANTEON_TELEGRAM_CHAT_ID=

# Pavarotti / Chatterbox
CHATTERBOX_DEVICE=cpu
CHATTERBOX_LANGUAGE=es
TORCH_THREADS=4
# Para GPU: https://download.pytorch.org/whl/cu124
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
