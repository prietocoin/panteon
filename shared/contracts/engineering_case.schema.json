{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://el-panteon.local/contracts/engineering_case.schema.json",
  "title": "EngineeringCase",
  "description": "Caso de ingeniería verificable producido por Galileo y consumido por Atlas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "source",
    "symptom",
    "cause",
    "solution",
    "hype_filter",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/definitions/source"
    },
    "symptom": {
      "$ref": "#/definitions/claim"
    },
    "cause": {
      "$ref": "#/definitions/claim"
    },
    "solution": {
      "$ref": "#/definitions/solution"
    },
    "hype_filter": {
      "$ref": "#/definitions/hypeFilter"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entity"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "retrieved_at", "content_hash"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "locator"],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "observable", "evidence"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "type": "string"
        },
        "observable": {
          "type": "boolean"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/metric"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/evidence"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "actions", "tradeoffs", "verification", "evidence"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/action"
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/evidence"
          }
        }
      }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "message", "penalty"],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "penalty": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hypeFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "verdict", "flags"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "verdict": {
          "type": "string",
          "enum": ["accept", "review", "reject"]
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/flag"
          }
        },
        "unsupported_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
